# Record Types Test - MBL v0.5.0

# Basic record creation
person = {
    name: "Alice",
    age: 30,
    salary: $75000.00,
    is_active: true
}

program.write("Person record: " + person)

# Record property access
program.write("Name: " + person.name)
program.write("Age: " + person.age)
program.write("Salary: " + person.salary)
program.write("Active: " + person.is_active)

# Nested records
company = {
    name: "Tech Corp",
    employees: 150,
    ceo: {
        name: "Bob Smith",
        age: 45,
        tenure: 5 years
    }
}

program.write("Company: " + company.name)
program.write("Employee count: " + company.employees)
program.write("CEO name: " + company.ceo.name)
program.write("CEO age: " + company.ceo.age)
program.write("CEO tenure: " + company.ceo.tenure)

# Records with computed values
project = {
    name: "MBL Language",
    start_date: @2020-01-01,
    duration: 2 years,
    completion: start_time + 6 months
}

program.write("Project: " + project.name)
program.write("Start date: " + project.start_date)
program.write("Duration: " + project.duration)