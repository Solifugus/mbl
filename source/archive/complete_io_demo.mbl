# Complete I/O System Demo - MBL Business Application
program.write("=== MBL Complete I/O System Demo ===")

# Interactive input
name = program.prompt("Enter your name: ")
age = program.prompt("Enter your age: ")

# Validation with error output
if age.len() == 0:
    program.error("WARNING: Age not provided")
    age = "unknown"

# Data processing simulation
program.write("Processing user data...")

if name.len() > 20:
    program.error("ERROR: Name too long (max 20 characters)")
    name = name.slice(0, 20)

# Results
program.write("")
program.write("User Profile:")
program.write("Name: " + name)
program.write("Age: " + age)

# Status symbols
program.write(symbol.checkmark + " Profile created successfully")
program.error("INFO: Profile saved to database")

program.write("")
program.write("Demo complete! " + symbol.checkmark)
