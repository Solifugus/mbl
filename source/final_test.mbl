program.write("=== MBL Function Test v0.7.0 ===")

calculate_sum(a, b):
	result = a + b
	return result

sum = calculate_sum(10, 20)
program.write("Sum test: " + sum)

greet(name, greeting):
	message = greeting + " " + name
	return message

msg1 = greet("Alice", "Hello")
program.write("Greet: " + msg1)

program.write("=== Test Complete ===")
