# MBL v0.3.0 Control Flow & Logic Test
# Testing if statements, boolean logic, and unary operators

program.write("=== MBL v0.3.0 Control Flow Tests ===")

# Basic boolean logic
program.write("Testing boolean logic operators:")
result_and = true and false
result_or = true or false
result_not = not true

program.write("true and false = " + result_and)
program.write("true or false = " + result_or)
program.write("not true = " + result_not)

program.write(empty)

# Unary operators
program.write("Testing unary operators:")
positive = 42
negative = -positive
double_negative = -negative

program.write("Original: " + positive)
program.write("Negative: " + negative)
program.write("Double negative: " + double_negative)

program.write(empty)

# Basic if statements
program.write("Testing if statements:")
age = 25
if age >= 18 then
    program.write("✓ You are an adult!")
else
    program.write("✗ You are a minor!")
end

score = 85
if score >= 90 then
    program.write("Grade: A")
else
    program.write("Grade: B or lower")
end

program.write(empty)

# Complex conditions
program.write("Testing complex conditions:")
has_license = true
has_car = false
money = $500.00

if has_license and (money > $200.00) then
    program.write("✓ Can afford insurance!")
else
    program.write("✗ Cannot afford insurance")
end

if has_license or has_car then
    program.write("✓ Has transportation option")
else
    program.write("✗ No transportation")
end

program.write(empty)

# Nested logic
program.write("Testing nested logic:")
temperature = 75
is_sunny = true
has_umbrella = false

if temperature > 70 then
    if is_sunny then
        program.write("Perfect weather for outdoor activities!")
    else
        if has_umbrella then
            program.write("Cloudy but prepared!")
        else
            program.write("Might want to bring an umbrella")
        end
    end
else
    program.write("Too cold for outdoor activities")
end

program.write(empty)

# Boolean expressions with all operators
program.write("Testing complex boolean expressions:")
a = true
b = false
c = true

result1 = a and b or c
result2 = a and (b or c)
result3 = (a and b) or c
result4 = not a or (b and c)

program.write("true and false or true = " + result1)
program.write("true and (false or true) = " + result2)
program.write("(true and false) or true = " + result3)
program.write("not true or (false and true) = " + result4)

program.write(empty)
program.write("=== All v0.3.0 tests completed! ===")