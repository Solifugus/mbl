# Memory stress test - lots of variables and function calls
create_large_record():
	data = "Large data string with lots of content to test memory allocation"
	count = 12345
	flag = true
	nested = "Another string to increase memory usage"
	return data + " " + nested

# Test multiple function calls
result1 = create_large_record()
result2 = create_large_record()
result3 = create_large_record()

program.write("Result 1: " + result1)
program.write("Result 2: " + result2)
program.write("Result 3: " + result3)

# Test function with parameters
combine_strings(a, b, c):
	temp1 = a + " "
	temp2 = temp1 + b
	temp3 = temp2 + " "
	final = temp3 + c
	return final

combined = combine_strings("Hello", "Beautiful", "World")
program.write("Combined: " + combined)