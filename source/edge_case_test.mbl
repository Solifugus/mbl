# Edge case testing
# Empty function
empty_func():
	return ""

# Function returning numbers and mixing types
add_mixed(x, y):
	return x + y

# Test empty and mixed operations
empty_result = empty_func()
program.write("Empty: " + empty_result)

mixed1 = add_mixed("Hello ", "World")
mixed2 = add_mixed(10, 20)
program.write("Mixed text: " + mixed1)
program.write("Mixed numbers: " + mixed2)

# Test nested function calls
nested_call():
	inner_result = empty_func()
	return "Nested: " + inner_result + "END"

nested = nested_call()
program.write("Nested result: " + nested)