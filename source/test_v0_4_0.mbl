# MBL v0.4.0 Feature Test - Variable Scoping & Block Statements

# =============================================================================
# MBL v0.4.0 introduces sophisticated variable scoping with local scopes
# for functions and control structures, plus explicit scope resolution.
# =============================================================================

program.write("=== MBL v0.4.0 Variable Scoping Tests ===")
program.write("")

# Test 1: Program-level variables
program.write("1. Program-level variable access:")
program_var = "Global value"
program.write("program_var = " + program_var)

# Test 2: Explicit program scope access
program.write("2. Explicit program scope access:")
program.counter = 42
program.write("program.counter = " + program.counter)

# Test 3: If-block local scoping
program.write("3. If-block local scoping:")
if 1 = 1 then
    # Local variable in if-block scope
    local_var = "Local to if-block"
    program.write("  Inside if: local_var = " + local_var)

    # Access program variable from local scope
    program.write("  Inside if: program_var = " + program_var)

    # Modify program variable from local scope
    program_var = "Modified from if-block"
    program.write("  Modified program_var to: " + program_var)
end

# Test 4: Local variable isolation
program.write("4. Local variable isolation:")
program.write("Outside if: program_var = " + program_var)
program.write("Outside if: local_var = " + local_var)  # Should be undefined

# Test 5: Nested scoping with else blocks
program.write("5. Nested scoping with else blocks:")
test_condition = false
if test_condition then
    else_test = "Won't execute"
else
    else_local = "Local to else block"
    program.write("  Inside else: else_local = " + else_local)

    # Test super scope access (for nested blocks)
    parent_value = "From parent"
    program.write("  Set parent_value = " + parent_value)
end

# Test 6: Super scope keyword (when implemented with nested functions)
program.write("6. Super scope resolution:")
program.write("else_local from program scope: " + else_local)  # Should be undefined

# Test 7: Program scope override
program.write("7. Program scope override:")
program.name = "Explicit program scope"
name = "Local scope version"  # This should create/update in current scope
program.write("program.name = " + program.name)
program.write("name = " + name)

# Test 8: Function block scoping (when functions are implemented)
program.write("8. Function scope testing:")
# testFunction():
#     function_local = "Local to function"
#     super.function_var = "Set in parent from function"
#     program.global_from_function = "Set in program from function"

# Test 9: Complex nested scoping
program.write("9. Complex nested access:")
outer_var = "Outer scope"
if true then
    inner_var = "Inner scope"
    program.write("  Inner scope sees outer: " + outer_var)
    program.write("  Inner scope has inner: " + inner_var)

    if true then
        deeply_nested = "Deep scope"
        program.write("    Deep scope sees outer: " + outer_var)
        program.write("    Deep scope sees inner: " + inner_var)
        program.write("    Deep scope has deep: " + deeply_nested)
    end

    program.write("  Back to inner - deep var: " + deeply_nested)  # Should be undefined
end

program.write("Back to program - inner var: " + inner_var)  # Should be undefined

# Test 10: Scope resolution summary
program.write("")
program.write("10. Scope Resolution Summary:")
program.write("✓ Program-level variables accessible globally")
program.write("✓ Local scopes created for if/else blocks")
program.write("✓ Variables resolve through scope chain")
program.write("✓ Explicit 'program.x' access supported")
program.write("✓ Local variables isolated from parent scopes")
program.write("✓ Nested scoping with proper isolation")

program.write("")
program.write("=== MBL v0.4.0 Variable Scoping Test Complete ===")