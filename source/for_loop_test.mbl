# For Loop Test - MBL v0.6.0

# Test for loop with list iteration
numbers = [1, 2, 3, 4, 5]
program.write("=== For Loop Test ===")
program.write("Numbers list: " + numbers)

program.write("Iterating over numbers:")
for num in numbers:
    program.write("  Number: " + num)

program.write("=== Test Complete ===")