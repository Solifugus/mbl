}

# Test property and index access
customer_balance = customer.account.balance
first_item = inventory[0]
property_by_string = record["dynamic key"]
nested_access = data.users[user_id].profile.email

# Test function declarations
calculate_tax(amount, rate = 0.08):
	base_tax = amount * rate
	if amount > $1000: base_tax *= 1.1
	return base_tax

process_order(customer, items, discount = $0):
	total = sum(items)
	tax = calculate_tax(total)
	final_amount = total + tax - discount
	customer.balance -= final_amount
	return final_amount

# Test activator declarations
low_inventory_alert stock.quantity < 10:
	program.write("Warning: Low stock for " + stock.item_name)
	program.file_write("alerts.log", "Low stock: " + stock.item_name)

complex_business_rule (order.amount > $500) and (customer.status = "premium") and not customer.blocked:
	discount = order.amount * 0.15
	order.final_price = order.amount - discount
	program.write("Applied premium discount: $" + discount)

# Test semicolon statement separation
x = 10; y = 20; z = x + y
if z > 25: program.write("Large sum"); total += z; count += 1

# Test indentation levels
if customer.vip_status:
	if order.amount > $1000:
		discount_rate = 0.20
		if customer.years_member > 5:
			discount_rate = 0.25
			program.write("Super VIP discount applied")
	else:
		discount_rate = 0.10

# Test mixed expressions with all token types
result = calculate_tax($1_250.75 + bonus, rate) * factor - @2:30 + quote
complex_condition = (balance >= $minimum) and (status != "blocked") or (override = true)

# Test program built-ins and scope keywords
user_input = program.read
program.write("Welcome: " + user_input)
config_data = program.file_read("config.txt")
api_response = program.network_get("https://api.example.com/rates")

# Test super keyword in nested scope
process_payment(amount):
	local_fee = amount * 0.03
	super.total_fees += local_fee
	program.total_processed += amount
	return amount - local_fee

# Test edge cases and combinations
edge_case_money = $0.01 BTC
scientific_time = @1735689600
unicode_string = "Café naïve résumé 中文 🌟"
mixed_expression = len("test") + max([1, 2, 3]) - typeof(balance) + sum(prices)

# Test all string methods
cleaned_email = email.lower().replace(" ", "")
name_parts = full_name.split(" ")
formatted_output = "Hello " + quote + customer.name.upper() + quote

# Test final complex scenario
main_business_logic:
	customer_data = program.file_read("customers.csv").split("\n")
	for line in customer_data:
		fields = line.split(",")
		customer = {
			id: fields[0],
			name: fields[1],
			balance: $fields[2],
			status: fields[3]
		}

		if customer.balance < $0:
			program.write("Overdue: " + customer.name)
			goto send_notice
		else:
			process_regular_customer(customer)

	return "Processing complete"

send_notice:
	program.network_post("https://notices.example.com", customer_data)
	program.file_write("overdue.log", customer.name + " is overdue")
	goto main_business_logic
