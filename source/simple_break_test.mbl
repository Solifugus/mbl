# Simple Break Test - MBL v0.6.0

program.write("=== For Loop with Break Test ===")
numbers = [1, 2, 3, 4, 5]
for num in numbers:
	program.write("Processing: " + num)
	if num == 3 then
		program.write("Breaking at 3")
		break
	end
	program.write("Completed: " + num)

program.write("=== For Loop with Continue Test ===")
items = [10, 20, 30, 40, 50]
for item in items:
	if item == 30 then
		program.write("Skipping 30")
		continue
	end
	program.write("Processing: " + item)

program.write("=== Test Complete ===")