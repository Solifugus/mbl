money = $150.00
has_discount = true

if has_discount and money > $100.00 then
    program.write("You qualify for premium discount!")
    final_price = money - $25.00
    program.write("Final price: " + final_price)
end

if not has_discount then
    program.write("No discount available")
else
    program.write("Discount applied!")
end
