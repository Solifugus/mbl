# MBL v0.5.0 Time Literal Test

program.write("=== Time Literal Test ===")

# Test 1: Current time
current_time = @now
program.write("Current time: " + current_time)

# Test 2: Date literal
birthday = @2020-05-15
program.write("Birthday: " + birthday)

# Test 3: Time literal
meeting_time = @14:30:00
program.write("Meeting time: " + meeting_time)

# Test 4: DateTime literal
event_datetime = @2020-05-15T14:30:00
program.write("Event datetime: " + event_datetime)

# Test 5: Unix timestamp
epoch_time = @1609459200
program.write("Epoch time: " + epoch_time)

program.write("=== Time Literal Test Complete ===")