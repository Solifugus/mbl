# MBL v0.2.0 Feature Test
# Testing string concatenation, math operations, comparison operators, and money arithmetic

program.write("=== MBL v0.2.0 Feature Tests ===")

# String concatenation tests
program.write("Testing string concatenation:")
name = "Alice"
greeting = "Hello, " + name
program.write(greeting)

age = 25
info = name + " is " + age + " years old"
program.write(info)

program.write(empty)

# Math operations tests
program.write("Testing arithmetic operations:")
a = 10
b = 3
sum = a + b
difference = a - b
product = a * b
quotient = a / b
remainder = a % b

program.write("10 + 3 = " + sum)
program.write("10 - 3 = " + difference)
program.write("10 * 3 = " + product)
program.write("10 / 3 = " + quotient)
program.write("10 % 3 = " + remainder)

program.write(empty)

# Money arithmetic tests
program.write("Testing money operations:")
price1 = $100.00
price2 = $25.50
total = price1 + price2
savings = price1 - price2

program.write("$100.00 + $25.50 = " + total)
program.write("$100.00 - $25.50 = " + savings)

program.write(empty)

# Comparison operators tests
program.write("Testing comparison operators:")
x = 15
y = 10

program.write("15 == 10: " + (x == y))
program.write("15 != 10: " + (x != y))
program.write("15 > 10: " + (x > y))
program.write("15 < 10: " + (x < y))
program.write("15 >= 10: " + (x >= y))
program.write("15 <= 10: " + (x <= y))

program.write(empty)

# Boolean and logical tests
program.write("Testing boolean operations:")
is_adult = age >= 18
has_money = total > $50.00

program.write("Age >= 18: " + is_adult)
program.write("Total > $50: " + has_money)
program.write("Adult AND has money: " + (is_adult and has_money))
program.write("Adult OR has money: " + (is_adult or has_money))

program.write(empty)
program.write("=== All tests completed! ===")