program.write("=== Comprehensive Time Test ===")

current_time = @now
program.write("1. @now: " + current_time)

date_only = @2020-05-15
program.write("2. Date: " + date_only)

time_only = @14:30:00
program.write("3. Time: " + time_only)

datetime_full = @2020-05-15T14:30:00
program.write("4. DateTime: " + datetime_full)

unix_timestamp = @1609459200
program.write("5. Unix timestamp: " + unix_timestamp)

program.write("=== All Time Formats Working! ===")