# Time Operations Test - MBL v0.5.0

# Basic time assignment
start_time = @2020-05-15T10:30:00
end_time = @2020-05-20T14:45:30

program.write("Start time: " + start_time)
program.write("End time: " + end_time)

# Time component access
program.write("Start year: " + start_time.year)
program.write("Start month: " + start_time.month)
program.write("Start day: " + start_time.day)
program.write("Start hour: " + start_time.hour)
program.write("Start minute: " + start_time.minute)
program.write("Start second: " + start_time.second)

# Time arithmetic - duration calculation
duration = end_time - start_time
program.write("Duration between times: " + duration)

# Time arithmetic - adding duration
future_time = start_time + duration
program.write("Future time (start + duration): " + future_time)

# Current time (@now)
current_time = @now
program.write("Current time: " + current_time)
program.write("Current year: " + current_time.year)
program.write("Current month: " + current_time.month)
program.write("Current day: " + current_time.day)

# Test with simple time
simple_time = @14:30:00
program.write("Simple time: " + simple_time)
program.write("Simple time hour: " + simple_time.hour)
program.write("Simple time minute: " + simple_time.minute)
program.write("Simple time second: " + simple_time.second)