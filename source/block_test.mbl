# Block Statement Test
program.write("=== Block Statement Test ===")

# Test indented block
if 1 = 1 then
	program.write("Inside if block - line 1")
	x = 42
	program.write("Inside if block - line 2, x = " + x)
end

program.write("After if block")

# Test function with block
testFunction():
	program.write("Inside function block")
	y = 100
	program.write("Function result: " + y)

program.write("=== Test completed! ===")