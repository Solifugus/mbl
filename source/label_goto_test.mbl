# MBL Label and Goto Test
# Testing basic label and goto functionality

program.write("=== MBL Label & Goto Test ===")

program.write("Starting at the beginning")
counter = 1

start:
program.write("At start label, counter = " + counter)

if counter < 3 then
    counter = counter + 1
    goto start
else
    goto finish
end

program.write("This should never print")

finish:
program.write("Reached the end label")
program.write("Final counter value: " + counter)

program.write("=== Test completed! ===")