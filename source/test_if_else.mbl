# Test if/else conditional statements
score = 85

if score > 90 then
	program.write("Excellent! Grade A")
else
	if score > 80 then
		program.write("Good job! Grade B")
	else
		if score > 70 then
			program.write("Passing. Grade C")
		else
			program.write("Needs improvement")
		end
	end
end

# Test with boolean variables
is_weekend = true
if is_weekend then
	program.write("It's the weekend!")
else
	program.write("It's a weekday")
end