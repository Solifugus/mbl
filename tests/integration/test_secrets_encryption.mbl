# Test MBL Secrets Encryption System

program.write("🔐 Testing MBL Secrets Encryption System")
program.write("========================================")

# Write a test secret
program.write("1. Writing encrypted secret...")
result = program.secret_write("test_api", {
    api_key: "sk_test_123456789",
    endpoint: "https://api.example.com",
    timeout: "30"
})

if result
    program.write("   ✅ Secret written successfully")
else
    program.write("   ❌ Failed to write secret")

# Read the secret back
program.write("2. Reading encrypted secret...")
secret = program.secret("test_api")

if secret != "undefined"
    program.write("   ✅ Secret loaded: " + secret.name)
    program.write("   📋 API Key: " + secret.attributes.api_key)
    program.write("   📋 Endpoint: " + secret.attributes.endpoint)
else
    program.write("   ❌ Failed to load secret")

# Update the secret
program.write("3. Updating encrypted secret...")
update_result = program.secret_write("test_api", {
    api_key: "sk_test_987654321",
    endpoint: "https://api.example.com/v2",
    timeout: "60",
    region: "us-east-1"
})

if update_result
    program.write("   ✅ Secret updated successfully")

# Verify update
updated = program.secret("test_api")
if updated.attributes.region = "us-east-1"
    program.write("   ✅ Update verified")

# Delete the secret
program.write("4. Deleting encrypted secret...")
delete_result = program.secret_delete("test_api")

if delete_result
    program.write("   ✅ Secret deleted successfully")

# Verify deletion
deleted_check = program.secret("test_api")
if deleted_check = "undefined"
    program.write("   ✅ Deletion verified")

program.write("")
program.write("🎉 Encryption test complete!")