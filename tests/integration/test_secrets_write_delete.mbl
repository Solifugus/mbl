# Test MBL Secrets Write/Delete Functionality
program.write("🔐 Testing MBL Secrets Write/Delete Operations")

# Create new secret attributes
new_secret_attrs = {
    host: "localhost",
    port: "3306",
    username: "testuser",
    password: "testpass123",
    database: "test_db"
}

program.write("📝 Writing new secret 'test_database'...")
write_result = program.secret_write("test_database", new_secret_attrs)
if write_result == true:
    program.write("✅ Secret written successfully")
else:
    program.write("❌ Failed to write secret: " + write_result)

# Read the secret back to verify
program.write("📖 Reading back the secret...")
stored_secret = program.secret("test_database")
if stored_secret != "undefined":
    program.write("✅ Secret found:")
    program.write("  Host: " + stored_secret.attributes.host)
    program.write("  Port: " + stored_secret.attributes.port)
    program.write("  Database: " + stored_secret.attributes.database)
else:
    program.write("❌ Secret not found after writing")

# Update the secret with new information
program.write("📝 Updating secret with new password...")
updated_attrs = {
    host: "production.example.com",
    port: "5432",
    username: "produser",
    password: "new_secure_password_456",
    database: "production_db"
}

update_result = program.secret_write("test_database", updated_attrs)
if update_result == true:
    program.write("✅ Secret updated successfully")
else:
    program.write("❌ Failed to update secret: " + update_result)

# Read updated secret
updated_secret = program.secret("test_database")
if updated_secret != "undefined":
    program.write("✅ Updated secret verified:")
    program.write("  Host: " + updated_secret.attributes.host)
    program.write("  Password: " + updated_secret.attributes.password)
else:
    program.write("❌ Updated secret not found")

# Test deletion
program.write("🗑️ Deleting test secret...")
delete_result = program.secret_delete("test_database")
if delete_result == true:
    program.write("✅ Secret deleted successfully")
else:
    program.write("❌ Failed to delete secret")

# Verify deletion
program.write("🔍 Verifying secret is deleted...")
deleted_check = program.secret("test_database")
if deleted_check == "undefined":
    program.write("✅ Secret successfully removed")
else:
    program.write("❌ Secret still exists after deletion")

program.write("🎯 Secrets write/delete test completed!")